{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude/launcher-settings.json)",
      "Read(~/.claude.json)",
      "Read(**/.credentials.json)",
      "Read(**/gha-creds-*.json)",
      "Read(**/service-account*.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/muro/muro.py\"",
            "timeout": 20,
            "statusMessage": "Muro de contención: revisando puertas"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/muro/muro.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|Read|Grep|Edit|Write|MultiEdit|NotebookEdit|WebFetch|Skill|SendMessage|CronCreate|CronDelete|RemoteTrigger|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/muro/muro.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|Read|WebFetch|WebSearch|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/muro/muro.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
